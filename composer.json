{
    "name": "saij/wp-app-framework",
    "description": "Framework for standalone full site editing themes for WordPress.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Saij\\WpAppFramework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saij\\WpAppFramework\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/wp-app-framework"
    ],
    "scripts": {
        "test": "phpunit",
        "lint": [
            "phpstan analyse --no-progress --memory-limit=1G",
            "php-cs-fixer check --diff"
        ],
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    }
}
