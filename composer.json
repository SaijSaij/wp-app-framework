{
    "name": "saij/wp-app-framework",
    "description": "Framework for standalone full site editing themes for WordPress.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Saij\\WpAppFramework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saij\\WpAppFramework\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/wp-app-framework"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    }
}
